POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app
# Use "db" when running via docker compose, "localhost" when running locally.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Grader model. Any OpenAI-compatible endpoint works: Cerebras, Groq, OpenRouter,
# or a self-hosted Ollama. Leave LLM_API_KEY empty and the grader marks every
# criterion "unmarked" instead of failing. Check the provider's console for the
# current model names — free rosters change.
LLM_BASE_URL=https://api.cerebras.ai/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=120
# Must fit the critic's worst case: CRITIC_MAX_FINDINGS findings, each up to
# quote+problem+why chars. Cyrillic tokenizes poorly, so budget generously —
# a cut-off answer fails the job outright.
LLM_MAX_OUTPUT_TOKENS=6000
LLM_MAX_RETRIES=3

# Grader: length caps on what the model may return, and how close a quoted
# fragment must be to the submission to count as located (0-100).
GRADER_MAX_COMMENT_CHARS=200
GRADER_MAX_SUMMARY_CHARS=1200
GRADER_MAX_EVIDENCE_CHARS=300
GRADER_MATCH_THRESHOLD=75

# Critic: the pass that looks for errors before anything is graded. max_findings
# caps the list after it is sorted worst-first, so a lower value drops the least
# serious findings.
CRITIC_MAX_QUOTE_CHARS=300
CRITIC_MAX_PROBLEM_CHARS=300
CRITIC_MAX_WHY_CHARS=200
CRITIC_MAX_FINDINGS=20
CRITIC_MATCH_THRESHOLD=75

# Prompts are not here: app/prompts.py holds them, since a multi-line Russian
# prompt is unusable as an environment variable.

# Cross-check (anti-plagiarism) tuning. Changing these changes what a similarity
# percentage means, so re-check them against reference solutions before moving.
CROSSCHECK_MIN_BLOCK_TOKENS=4
CROSSCHECK_MERGE_GAP_TOKENS=3
CROSSCHECK_BOILERPLATE_DOC_RATIO=0.6
CROSSCHECK_MIN_DOCS_FOR_BOILERPLATE=5
CROSSCHECK_THRESHOLD_PCT=25.0
CROSSCHECK_MAX_MATCHES=5

# AI-detection: GigaCheck-Classifier-Multi (Apache-2.0), run locally so student
# work never leaves the machine. Fetch the weights (~14.5 GB) once with:
#   uv run python -c "from huggingface_hub import snapshot_download; \
#     print(snapshot_download('iitolstykh/GigaCheck-Classifier-Multi'))"
# and put the printed snapshot directory here. Leave it empty and the job
# records status "unavailable" instead of failing the submission pipeline.
AICHECK_MODEL_DIR=
# Empty picks cuda, then mps, then cpu.
AICHECK_DEVICE=
# Spot-checked against text with verifiable authorship: human prose from 2018
# scored 0.0%, generated prose 100%, so 60 sits well inside the gap. It also
# decides which chunks count as flagged. Not a pass/fail gate.
AICHECK_REVIEW_THRESHOLD_PCT=60.0
# Short windows inflate the score — one text scored 98% on 110 words, 29% on
# 250 and 2% on 330 — so anything below this is left unscored.
AICHECK_MIN_WORDS=200
# The model window is 1024 tokens, which holds only ~330 Russian words, so long
# work is scored in chunks. A chunk costs ~8s of inference on an M-series GPU,
# and the cap keeps the worst case near a minute — the worker runs one job at a
# time, so this is also how long everything else waits behind it. Work longer
# than the cap allows is scored only in part.
AICHECK_MAX_CHUNKS=6
# A chunk that comes up short of this is extended backwards over already-scored
# text rather than dropped. Dropping it used to leave holes: a notebook's code
# block filled the window on tokens (1014 of 1022) while holding just 194 words,
# and vanished from the middle of the report.
AICHECK_MIN_CHUNK_WORDS=200

# Generate your own with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
